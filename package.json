{
  "name": "ideo-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Ideo — a private team workspace for ideas, brainstorms, plans, and tasks. Runs entirely on Cloudflare's free tier.",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --stream dev",
    "build": "pnpm --filter @ideo/web build",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "pnpm --filter @ideo/worker test",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply ideo-database --local",
    "db:migrate:remote": "wrangler d1 migrations apply ideo-database --remote",
    "verify": "pnpm typecheck && pnpm lint && pnpm build && pnpm test && pnpm deploy:dry-run"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "typescript": "5.9.3",
    "wrangler": "4.149.0"
  }
}
